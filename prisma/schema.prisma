generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Phase 0-1: System Access & Organization ──────────────────────

enum SystemRole {
  SUPER_ADMIN
  SYSTEM_ADMIN
  EXECUTIVE
  DEPT_MANAGER
  TEAM_LEADER
  OPERATIONS_MANAGER
  HR
  STAFF
  VA
}

enum UserType {
  INTERNAL_STAFF
  VIRTUAL_ASSISTANT
}

enum TemporaryRole {
  CONTRIBUTOR
  VIEWER
  APPROVER
}

// ── Phase 2: VA Workforce ────────────────────────────────────────

enum ContractType {
  REGULAR
  PROJECT_BASED
  PROBATIONARY
}

enum EmploymentStatus {
  EMPLOYED
  ENGAGED
  CONTRACTED
  END_OF_CONTRACT
  TRANSFERRED
  RESIGNED
  TERMINATED
  BLACKLISTED
}

enum HistoryEventType {
  STATUS_CHANGE
  ENGAGEMENT_CHANGE
  UPSKILL
  RATE_CHANGE
  PROMOTION
  DEPARTMENT_TRANSFER
}

enum TransferType {
  ACTIVE
  END_OF_CONTRACT
  HYBRID
}

enum Availability {
  AVAILABLE
  PARTIALLY_ASSIGNED
  FULLY_ASSIGNED
  ON_LEAVE
  UNAVAILABLE
}

enum Proficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum LeaveType {
  VACATION
  SICK
  EMERGENCY
  MATERNITY
  PATERNITY
  UNPAID
  BEREAVEMENT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentType {
  CONTRACT
  GOVERNMENT_ID
  NDA
  CLEARANCE
  CERTIFICATE
  ONBOARDING
  PERFORMANCE_REVIEW
  PORTFOLIO
  FOLDER_201
  FILE_201
  VA_CLIENT_FILE
  HEALTH_CHECK
  VA_PROFILE
  PAYOUT_SUMMARY
  DEPT_201_FOLDER
  OTHER
}

// ── Phase 3: Clients ─────────────────────────────────────────────

enum AssignmentType {
  REGULAR
  PROJECT
}

enum AssignmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum AssignmentSource {
  MANUAL
  VA_CONNECTIONS_SYNC
}

enum SkillCategory {
  STANDARD
  UPSKILL
  SPECIAL
}

enum ClientPlatform {
  AMAZON
  WALMART
  TIKTOK_SHOP
  SHOPIFY
  MULTI
}

// ── Phase 4: Ticketing ───────────────────────────────────────────

enum TicketCategory {
  TECHNICAL
  HR
  CLIENT
  VA_SUPPORT
  GENERAL
  TERMINATION
}

enum TerminationType {
  EOC // Type A — End of Contract, natural completion
  CLIENT_INITIATED // Type B — client requested the VA be removed
  VAA_INITIATED // Type C — VAA-initiated (resignation or removal)
}

enum TerminationWorkflowStatus {
  INITIATED
  // Voluntary-resignation-only stages (see Termination.isVoluntaryResignation)
  // — inserted between INITIATED and EXIT_SURVEY_PENDING for that sub-flow;
  // the existing simple flow (EOC/CLIENT_INITIATED/plain removal) never
  // produces these.
  PENDING_LETTER
  UNDER_DOCUMENTATION
  EXIT_SURVEY_PENDING
  CLEARANCE_PENDING
  CLEARANCE_PROCESSING
  COMPLIANCE_REVIEW_PENDING
  PAYOUT_PENDING
  COMPLETED
  CANCELLED
}

enum ExitClearanceDepartment {
  SERVICE_DEPARTMENT
  CUSTOMER_SUCCESS
  TRAINING
  ACCOUNTING
  HR
}

enum ClearanceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReplacementPipelineStatus {
  SOURCED
  ENDORSED
  INTERVIEWED
  APPROVED
  REJECTED
  NOT_APPLICABLE
}

enum ResignationIntakeStatus {
  PENDING_REVIEW
  CONVERTED
  DISMISSED
}

enum ComplianceReviewResult {
  PASS
  FLAGGED
}

enum FinalPayoutStatus {
  PENDING
  PROCESSED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
}

enum TicketSource {
  INTERNAL
  EMAIL
  WHATSAPP
  CLIENT_PORTAL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ── Audit ────────────────────────────────────────────────────────

enum NotificationType {
  NEW_ASSIGNMENT
  HOURS_SHORTFALL
  NEW_MESSAGE
  MESSAGE_REPLY
  RESIGNATION_INTAKE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  TRANSFER
  APPROVE
  REJECT
  FILE_UPLOAD
  SIGN_IN
  SIGN_OUT
  MEMBER_ADD
  MEMBER_REMOVE
  ROLE_CHANGE
  LOGIN_FAILED
}

// ── Departments ──────────────────────────────────────────────────

enum DepartmentStatus {
  ACTIVE
  MERGED
  SPLIT
  INACTIVE
}

enum DepartmentLevel {
  EXECUTIVE
  MANAGEMENT
  SERVICE
}

enum GeneralStatus {
  ACTIVE
  PENDING
  TRANSFERRED
  RESIGNED
  REMOVED
  PROJECT_ENDED
  CANCELLED
  BLACKLISTED
  UNIDENTIFIED
}

// ──────────────────────────────────────────────────────────────────
// MODELS — Phase 0-1: Core Organization
// ──────────────────────────────────────────────────────────────────

model Department {
  id           String           @id @default(cuid())
  name         String
  shortName    String?          @map("short_name")
  acronym      String?
  level        DepartmentLevel?
  status       DepartmentStatus @default(ACTIVE)
  parentId     String?          @map("parent_id")
  parent       Department?      @relation("DeptHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Department[]     @relation("DeptHierarchy")
  mergedIntoId String?          @map("merged_into_id")
  mergedInto   Department?      @relation("DepartmentMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Department[]     @relation("DepartmentMerge")
  splitFromId  String?          @map("split_from_id")
  splitFrom    Department?      @relation("DepartmentSplit", fields: [splitFromId], references: [id], onDelete: SetNull)
  splitInto    Department[]     @relation("DepartmentSplit")
  isParent     Boolean          @default(false) @map("is_parent")
  description  String?
  // Standard rate for this department/service — pre-fills (but doesn't force)
  // the per-membership rate override when transferring a VA in, per the
  // 2026-08-12 Workforce Management System meeting's request to document
  // base rates per department for upskilling transfers.
  baseRate     Decimal?         @map("base_rate")
  headId       String?          @map("head_id")
  head         User?            @relation("DeptHead", fields: [headId], references: [id], onDelete: SetNull)
  sortOrder    Int              @default(0) @map("sort_order")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  memberships        DepartmentMembership[]
  positions          Position[]
  clients            Client[]
  tickets            Ticket[]
  auditLogs          AuditLog[]
  roleAssignments    RoleAssignment[]
  services           DepartmentSkill[]
  vaHistoryEvents    VAHistory[]
  employmentRecords  EmploymentRecord[]
  channel            Channel?
  teams              Team[]                 @relation("DepartmentTeams")
  resignationIntakes ResignationIntake[]

  @@unique([name, parentId])
  @@unique([acronym, parentId])
  @@map("departments")
}

model Position {
  id           String        @id @default(cuid())
  title        String
  reportsToId  String?       @map("reports_to_id")
  reportsTo    Position?     @relation("PositionChain", fields: [reportsToId], references: [id], onDelete: SetNull)
  subordinates Position[]    @relation("PositionChain")
  departmentId String?       @map("department_id")
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  isStaffRole  Boolean       @default(false) @map("is_staff_role")
  sortOrder    Int           @default(0) @map("sort_order")
  status       GeneralStatus @default(ACTIVE) @map("general_status")
  onHold       Boolean       @default(false) @map("on_hold")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  memberships DepartmentMembership[]

  @@map("positions")
}

model DepartmentMembership {
  id                String                 @id @default(cuid())
  userId            String                 @map("user_id")
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId      String                 @map("department_id")
  department        Department             @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  positionId        String?                @map("position_id")
  position          Position?              @relation(fields: [positionId], references: [id], onDelete: SetNull)
  isPrimary         Boolean                @default(false) @map("is_primary")
  hourlyRate        Decimal?               @map("hourly_rate")
  baseRate          Decimal?               @map("base_rate")
  transferType      TransferType?          @map("transfer_type")
  transferredFromId String?                @map("transferred_from_id")
  transferredFrom   DepartmentMembership?  @relation("MembershipTransferChain", fields: [transferredFromId], references: [id], onDelete: SetNull)
  transferredTo     DepartmentMembership[] @relation("MembershipTransferChain")
  startedAt         DateTime               @default(now()) @map("started_at")
  endedAt           DateTime?              @map("ended_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@index([userId, departmentId])
  @@map("department_memberships")
}

// ──────────────────────────────────────────────────────────────────
// MODELS — Phase 0-1: Users & Personnel
// ──────────────────────────────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  employeeId   String?       @unique @map("employee_id")
  firstName    String        @map("first_name")
  middleName   String?       @map("middle_name")
  lastName     String        @map("last_name")
  extName      String?       @map("ext_name")
  systemRole   SystemRole    @map("system_role")
  userType     UserType      @map("user_type")
  avatarUrl    String?       @map("avatar_url")
  messageColor MessageColor  @default(BLUE) @map("message_color")
  status       GeneralStatus @default(ACTIVE) @map("general_status")
  onHold       Boolean       @default(false) @map("on_hold")
  isActive     Boolean       @default(true) @map("is_active")
  // Marks a system/automation account (e.g. Vee) so the UI can show a "Bot"
  // badge next to its name instead of it looking like a real staff member.
  isBot        Boolean       @default(false) @map("is_bot")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  profile                    UserProfile?
  vaProfile                  VAProfile?
  departmentHead             Department[]           @relation("DeptHead")
  memberships                DepartmentMembership[]
  employmentRecords          EmploymentRecord[]
  employmentRecordsInitiated EmploymentRecord[]     @relation("EmploymentInitiator")
  roleAssignments            RoleAssignment[]
  grantedRoleAssignments     RoleAssignment[]       @relation("RoleGranter")
  leaveRequests              LeaveRequest[]         @relation("LeaveRequestor")
  approvedLeaves             LeaveRequest[]         @relation("LeaveApprover")
  managedClients             Client[]               @relation("ClientManager")
  uploadedDocuments          VADocument[]           @relation("DocUploader")
  createdTickets             Ticket[]               @relation("TicketCreator")
  assignedTickets            Ticket[]               @relation("TicketAssignee")
  ticketConversations        TicketConversation[]
  auditLogs                  AuditLog[]
  vaHistoryEvents            VAHistory[]            @relation("VAHistoryUser")
  vaHistoryChanges           VAHistory[]            @relation("VAHistoryChangedBy")
  notifications              Notification[]
  sidebarFavorites           SidebarFavorite[]
  messages                   Message[]
  messageMentions            MessageMention[]
  channelReads               ChannelRead[]
  pinnedMessages             Message[]              @relation("MessagePinnedBy")
  channelParticipants        ChannelParticipant[]
  ledTeams                   Team[]                 @relation("TeamLeader")
  tempLedTeams1              Team[]                 @relation("TeamTempLeader1")
  tempLedTeams2              Team[]                 @relation("TeamTempLeader2")
  teamMemberships            TeamMembership[]       @relation("TeamMember")
  onboardingInvite           VAOnboardingInvite?
  onboardingInvitesCreated   VAOnboardingInvite[]   @relation("OnboardingInviteCreator")
  terminationsInitiated      Termination[]          @relation("TerminationInitiator")
  clearancesCleared          ExitClearance[]        @relation("ClearanceClearedBy")
  agentDecisions             AgentSuggestion[]      @relation("AgentSuggestionDecidedBy")

  // Resignation SOP extension
  resignationLwdOverrides    ResignationDiscussion[] @relation("ResignationLwdOverrideBy")
  resignationTrainingNotes   Termination[]           @relation("ResignationTrainingNotedBy")
  replacementCandidacies     ReplacementRequest[]    @relation("ReplacementCandidate")
  replacementApprovals       ReplacementRequest[]    @relation("ReplacementApprovedBy")
  exitClearanceApprovals     ExitClearanceApproval[] @relation("ExitClearanceApprover")
  complianceReviewsPerformed ComplianceReview[]      @relation("ComplianceReviewedBy")
  finalPayoutsEndorsed       FinalPayout[]           @relation("FinalPayoutEndorsedBy")
  resignationIntakesReviewed ResignationIntake[]     @relation("ResignationIntakeReviewer")

  @@index([email])
  @@index([systemRole])
  @@index([userType])
  @@map("users")
}

model UserProfile {
  id                       String    @id @default(cuid())
  userId                   String    @unique @map("user_id")
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone                    String?
  whatsappNumber           String?   @map("whatsapp_number")
  gender                   String?
  birthDate                DateTime? @map("birth_date")
  nonCelebrant             Boolean   @default(false) @map("non_celebrant")
  birthdayCelebrant        Boolean   @default(true) @map("birthday_celebrant")
  barangay                 String?
  cityMunicipality         String?   @map("city_municipality")
  province                 String?
  houseNumber              String?   @map("house_number")
  zipCode                  String?   @map("zip_code")
  landmark                 String?
  address                  String?
  addressLine              String?   @map("address_line")
  emergencyContactName     String?   @map("emergency_contact_name")
  emergencyContactPhone    String?   @map("emergency_contact_phone")
  emergencyContactRelation String?   @map("emergency_contact_relation")
  religion                 String?
  gcashNumber              String?   @map("gcash_number")
  personalEmail            String?   @map("personal_email")
  workEmail                String?   @map("work_email")
  regionCode               String?   @map("region_code")
  provinceCode             String?   @map("province_code")
  cityCode                 String?   @map("city_code")
  barangayCode             String?   @map("barangay_code")
  facebookName             String?   @map("facebook_name")
  facebookUrl              String?   @map("facebook_url")
  linkedinUrl              String?   @map("linkedin_url")
  payoneerAccount          String?   @map("payoneer_account")
  payoneerId               String?   @map("payoneer_id")
  passportNumber           String?   @map("passport_number")
  passportPhoto            String?   @map("passport_photo")
  philhealthNumber         String?   @map("philhealth_number")
  philhealthPhoto          String?   @map("philhealth_photo")
  signedContract           String?   @map("signed_contract")
  personalityTraits        String[]  @map("personality_traits")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model EmploymentRecord {
  id               String           @id @default(cuid())
  userId           String           @map("user_id")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId     String?          @map("department_id")
  department       Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  contractType     ContractType     @map("contract_type")
  employmentStatus EmploymentStatus @map("employment_status")
  startDate        DateTime         @map("start_date")
  endDate          DateTime?        @map("end_date")
  effectiveDate    DateTime         @default(now()) @map("effective_date")
  reason           String?
  initiatedBy      String?          @map("initiated_by")
  initiator        User?            @relation("EmploymentInitiator", fields: [initiatedBy], references: [id], onDelete: SetNull)
  isCurrent        Boolean          @default(true) @map("is_current")
  tenureDays       Int?             @map("tenure_days")
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([userId])
  @@index([employmentStatus])
  @@index([departmentId, startDate])
  @@map("employment_records")
}

model RoleAssignment {
  id           String        @id @default(cuid())
  userId       String        @map("user_id")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         TemporaryRole
  module       String
  departmentId String?       @map("department_id")
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  grantedBy    String        @map("granted_by")
  grantor      User          @relation("RoleGranter", fields: [grantedBy], references: [id], onDelete: Cascade)
  expiresAt    DateTime?     @map("expires_at")
  status       GeneralStatus @default(ACTIVE) @map("general_status")
  onHold       Boolean       @default(false) @map("on_hold")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@map("role_assignments")
}

// ──────────────────────────────────────────────────────────────────
// MODELS — Phase 2: VA Workforce
// ──────────────────────────────────────────────────────────────────

model VAProfile {
  id                  String            @id @default(cuid())
  userId              String            @unique @map("user_id")
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  hourlyRate          Decimal?          @map("hourly_rate")
  baseRate            Decimal?          @map("base_rate")
  vaaPosition         String?           @map("vaa_position")
  positionSkillId     String?           @map("position_skill_id")
  positionSkill       Skill?            @relation(fields: [positionSkillId], references: [id], onDelete: SetNull)
  level               String?
  availabilityStatus  Availability      @default(AVAILABLE) @map("availability_status")
  recommendability    String?           @map("recommendability")
  totalCapacityHours  Decimal?          @default(40) @map("total_capacity_hours")
  preferredWorkHours  Decimal?          @map("preferred_work_hours")
  availableSchedule   String?           @map("available_schedule")
  hybrid              Boolean           @default(false)
  onboardingFolderUrl String?           @map("onboarding_folder_url")
  portfolioUrl        String?           @map("portfolio_url")
  contractLink        String?           @map("contract_link")
  folder201Link       String?           @map("folder_201_link")
  file201Link         String?           @map("file_201_link")
  vaClientFileLink    String?           @map("va_client_file_link")
  healthCheckFileLink String?           @map("health_check_file_link")
  vaProfileLink       String?           @map("va_profile_link")
  payoutSummaryLink   String?           @map("payout_summary_link")
  dept201FolderLink   String?           @map("dept_201_folder_link")
  notes               String?
  status              GeneralStatus     @default(ACTIVE) @map("general_status")
  onHold              Boolean           @default(false) @map("on_hold")
  engagementStatus    EmploymentStatus? @map("engagement_status")
  currentHireDate     DateTime?         @map("current_hire_date")
  currentEndDate      DateTime?         @map("current_end_date")
  isActive            Boolean           @default(true) @map("is_active")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  assignments  Assignment[]
  workLogs     WorkLog[]
  vaSkills     VASkill[]
  documents    VADocument[]
  terminations Termination[]

  agentSuggestions AgentSuggestion[]

  @@index([availabilityStatus])
  @@index([positionSkillId])
  @@index([currentHireDate])
  @@map("va_profiles")
}

model VAHistory {
  id            String           @id @default(cuid())
  userId        String           @map("user_id")
  user          User             @relation("VAHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  eventType     HistoryEventType @map("event_type")
  oldValue      String?          @map("old_value")
  newValue      String?          @map("new_value")
  departmentId  String?          @map("department_id")
  department    Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  effectiveDate DateTime         @map("effective_date")
  reason        String?
  changedById   String           @map("changed_by_id")
  changedBy     User             @relation("VAHistoryChangedBy", fields: [changedById], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([userId, effectiveDate])
  @@index([eventType, effectiveDate])
  @@map("va_history")
}

model Skill {
  id             String        @id @default(cuid())
  name           String        @unique
  shortName      String?       @map("short_name")
  acronym        String?       @unique
  category       SkillCategory @default(STANDARD)
  jobDescription String?       @map("job_description")
  attachmentUrl  String?       @map("attachment_url")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  vaSkills       VASkill[]
  departments    DepartmentSkill[]
  positionForVAs VAProfile[]

  @@map("skills")
}

model DepartmentSkill {
  id           String     @id @default(cuid())
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  skillId      String     @map("skill_id")
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([departmentId, skillId])
  @@map("department_skills")
}

model VASkill {
  id              String      @id @default(cuid())
  vaProfileId     String      @map("va_profile_id")
  vaProfile       VAProfile   @relation(fields: [vaProfileId], references: [id], onDelete: Cascade)
  skillId         String      @map("skill_id")
  skill           Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency     Proficiency @default(INTERMEDIATE)
  yearsExperience Decimal?    @map("years_experience")
  isPrimary       Boolean     @default(false) @map("is_primary")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@unique([vaProfileId, skillId])
  @@map("va_skills")
}

model VADocument {
  id             String       @id @default(cuid())
  vaProfileId    String       @map("va_profile_id")
  vaProfile      VAProfile    @relation(fields: [vaProfileId], references: [id], onDelete: Cascade)
  documentType   DocumentType @map("document_type")
  fileName       String       @map("file_name")
  googleDriveUrl String       @map("google_drive_url")
  mimeType       String?      @map("mime_type")
  fileSize       Int?         @map("file_size")
  uploadedBy     String       @map("uploaded_by")
  uploader       User         @relation("DocUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)
  expiresAt      DateTime?    @map("expires_at")
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([vaProfileId])
  @@map("va_documents")
}

model LeaveRequest {
  id               String      @id @default(cuid())
  userId           String      @map("user_id")
  user             User        @relation("LeaveRequestor", fields: [userId], references: [id], onDelete: Cascade)
  leaveType        LeaveType   @map("leave_type")
  startDate        DateTime    @map("start_date")
  endDate          DateTime    @map("end_date")
  totalDays        Decimal     @map("total_days")
  reason           String?
  status           LeaveStatus @default(PENDING)
  approverId       String?     @map("approver_id")
  approver         User?       @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?   @map("approved_at")
  approverNote     String?     @map("approver_note")
  notificationSent Boolean     @default(false) @map("notification_sent")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("leave_requests")
}

// Per-year sequence backing employeeId's "VA-<YY>-<seq>" format — a real
// row-level UPDATE...RETURNING counter, not a count()-based scheme, so
// concurrent VA creation can't produce duplicate employee IDs.
model EmployeeIdCounter {
  year    Int @id
  lastSeq Int @default(0) @map("last_seq")

  @@map("employee_id_counters")
}

model VAOnboardingInvite {
  id          String    @id @default(cuid())
  userId      String    @unique @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  completedAt DateTime? @map("completed_at")
  createdBy   String    @map("created_by")
  creator     User      @relation("OnboardingInviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("va_onboarding_invites")
}

// ──────────────────────────────────────────────────────────────────
// MODELS — Phase 3: Clients & Service Lines
// ──────────────────────────────────────────────────────────────────

// NOTE: this model's UI label is "Client Assignment" — one row is one
// company's staffing request for one department, not the company's overall
// identity (that's Customer/Account below). Kept named `Client`/`clients`
// internally to avoid a high-risk table rename; only user-facing copy says
// "Client Assignment".
model Client {
  id                  String         @id @default(cuid())
  name                String
  contactName         String?        @map("contact_name")
  contactEmail        String?        @map("contact_email")
  contactPhone        String?        @map("contact_phone")
  platform            ClientPlatform @default(MULTI)
  industry            String?
  timezone            String?        @default("America/New_York")
  notes               String?
  status              GeneralStatus  @default(ACTIVE) @map("general_status")
  onHold              Boolean        @default(false) @map("on_hold")
  isActive            Boolean        @default(true) @map("is_active")
  managerId           String?        @map("manager_id")
  manager             User?          @relation("ClientManager", fields: [managerId], references: [id], onDelete: SetNull)
  departmentId        String?        @map("department_id")
  department          Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  onboardingFolderUrl String?        @map("onboarding_folder_url")
  website             String?
  requestType         String?        @map("request_type")
  businessModel       String?        @map("business_model")
  serviceType         String?        @map("service_type")
  secondaryContact    String?        @map("secondary_contact")
  meetingDate         DateTime?      @map("meeting_date")
  targetStartDate     DateTime?      @map("target_start_date")
  requiredSkills      String[]       @map("required_skills")
  intakeDetails       Json?          @map("intake_details")
  formDetails         Json?          @map("form_details")
  accountId           String?        @map("account_id")
  account             Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  assignments Assignment[]
  tickets     Ticket[]

  pipeline         ClientPipeline?
  agentSuggestions AgentSuggestion[]

  @@index([departmentId])
  @@index([accountId])
  @@map("clients")
}

model Assignment {
  id                String           @id @default(cuid())
  type              AssignmentType
  status            AssignmentStatus @default(ACTIVE)
  agreedHours       Decimal          @map("agreed_hours")
  monthlyHours      Decimal?         @map("monthly_hours")
  startDate         DateTime         @map("start_date")
  endDate           DateTime?        @map("end_date")
  notes             String?
  skillRequirements String[]         @map("skill_requirements")
  source            AssignmentSource @default(MANUAL)
  externalId        String?          @unique @map("external_id")
  syncedAt          DateTime?        @map("synced_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  vaProfileId String    @map("va_profile_id")
  vaProfile   VAProfile @relation(fields: [vaProfileId], references: [id], onDelete: Cascade)

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  workLogs     WorkLog[]
  terminations Termination[]

  @@index([vaProfileId])
  @@index([clientId])
  @@index([status])
  @@map("assignments")
}

model WorkLog {
  id          String   @id @default(cuid())
  workDate    DateTime @map("work_date")
  hours       Decimal
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  vaProfileId String    @map("va_profile_id")
  vaProfile   VAProfile @relation(fields: [vaProfileId], references: [id], onDelete: Cascade)

  assignmentId String     @map("assignment_id")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([vaProfileId])
  @@index([assignmentId])
  @@index([workDate])
  @@map("work_logs")
}

// ──────────────────────────────────────────────────────────────────
// MODELS — Phase 4: Communications & Ticketing
// ──────────────────────────────────────────────────────────────────

model Ticket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique @map("ticket_number")
  title        String
  description  String?
  category     TicketCategory
  priority     Priority       @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  source       TicketSource   @default(INTERNAL)
  createdBy    String         @map("created_by")
  creator      User           @relation("TicketCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  assignedTo   String?        @map("assigned_to")
  assignee     User?          @relation("TicketAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  departmentId String?        @map("department_id")
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  clientId     String?        @map("client_id")
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?      @map("resolved_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  conversations     TicketConversation[]
  termination       Termination?
  resignationIntake ResignationIntake?

  @@index([assignedTo])
  @@index([departmentId])
  @@index([status])
  @@map("tickets")
}

model TicketConversation {
  id             String   @id @default(cuid())
  ticketId       String   @map("ticket_id")
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message        String
  isInternalNote Boolean  @default(false) @map("is_internal_note")
  attachments    String[]
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("ticket_conversations")
}

// ──────────────────────────────────────────────────────────────────
// MODELS — Phase 5: Offboarding
// ──────────────────────────────────────────────────────────────────

model Termination {
  id                     String                    @id @default(cuid())
  vaProfileId            String                    @map("va_profile_id")
  vaProfile              VAProfile                 @relation(fields: [vaProfileId], references: [id], onDelete: Cascade)
  assignmentId           String?                   @map("assignment_id")
  assignment             Assignment?               @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  type                   TerminationType
  // Distinguishes the SOP's voluntary-resignation sub-flow (discussion,
  // replacement, 5-department clearance, compliance review, payout SLA)
  // from a plain VAA_INITIATED involuntary removal, which today's
  // TerminationType conflates per its own comment. All satellite models
  // below only ever exist when this is true.
  isVoluntaryResignation Boolean                   @default(false) @map("is_voluntary_resignation")
  affectsBothParties     Boolean                   @default(false) @map("affects_both_parties")
  resultingStatus        EmploymentStatus          @map("resulting_status")
  reason                 String?
  workflowStatus         TerminationWorkflowStatus @default(INITIATED) @map("workflow_status")
  ticketId               String?                   @unique @map("ticket_id")
  ticket                 Ticket?                   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  resignationDocUrl      String?                   @map("resignation_doc_url")
  initiatedById          String                    @map("initiated_by_id")
  initiatedBy            User                      @relation("TerminationInitiator", fields: [initiatedById], references: [id], onDelete: Cascade)
  effectiveDate          DateTime                  @map("effective_date")
  completedAt            DateTime?                 @map("completed_at")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  exitSurveyInvite ExitSurveyInvite?
  clearance        ExitClearance?

  // Voluntary-resignation-only satellites
  discussion         ResignationDiscussion?
  replacementRequest ReplacementRequest?
  clearanceApprovals ExitClearanceApproval[]
  complianceReview   ComplianceReview?
  finalPayout        FinalPayout?

  // FR-017, Customer-Only path: a manual toggle (not a full training
  // sub-module) confirming the VA has cleared the reassignment training
  // gate before being handed a new client. Left null for the
  // Customer+Company path, which has no reassignment.
  trainingPassedAt  DateTime? @map("training_passed_at")
  trainingNotedById String?   @map("training_noted_by_id")
  trainingNotedBy   User?     @relation("ResignationTrainingNotedBy", fields: [trainingNotedById], references: [id], onDelete: SetNull)

  intake ResignationIntake?

  @@index([vaProfileId])
  @@index([assignmentId])
  @@index([workflowStatus])
  @@map("terminations")
}

// ── Voluntary resignation satellites (Termination.isVoluntaryResignation) ──

model ResignationDiscussion {
  id            String      @id @default(cuid())
  terminationId String      @unique @map("termination_id")
  termination   Termination @relation(fields: [terminationId], references: [id], onDelete: Cascade)

  scheduledAt       DateTime? @map("scheduled_at")
  conductedAt       DateTime? @map("conducted_at")
  retained          Boolean?
  recordingLink     String?   @map("recording_link")
  turnoverDiscussed Boolean   @default(false) @map("turnover_discussed")

  // BR-02: 30-working-day standard notice, 10-working-day (2-week) minimum.
  lastWorkingDay    DateTime? @map("last_working_day")
  lwdOverrideReason String?   @map("lwd_override_reason")
  lwdOverrideById   String?   @map("lwd_override_by_id")
  lwdOverrideBy     User?     @relation("ResignationLwdOverrideBy", fields: [lwdOverrideById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("resignation_discussions")
}

model ReplacementRequest {
  id            String      @id @default(cuid())
  terminationId String      @unique @map("termination_id")
  termination   Termination @relation(fields: [terminationId], references: [id], onDelete: Cascade)

  pipelineStatus  ReplacementPipelineStatus @default(SOURCED) @map("pipeline_status")
  candidateUserId String?                   @map("candidate_user_id")
  candidateUser   User?                     @relation("ReplacementCandidate", fields: [candidateUserId], references: [id], onDelete: SetNull)
  approvedById    String?                   @map("approved_by_id")
  approvedBy      User?                     @relation("ReplacementApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?                 @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("replacement_requests")
}

// One current-state row per department per termination; a rejection reopens
// only that row — the other 4 stay untouched (Miro exit-clearance diagram).
// checklistItems holds the paper Exit Clearance Form's per-department items
// as JSON since they differ per department and may change wording without a
// migration. Sibling to (not nested under) the existing single-approver
// ExitClearance model, which stays untouched for non-resignation terminations.
model ExitClearanceApproval {
  id            String      @id @default(cuid())
  terminationId String      @map("termination_id")
  termination   Termination @relation(fields: [terminationId], references: [id], onDelete: Cascade)

  department     ExitClearanceDepartment
  approverId     String?                 @map("approver_id")
  approver       User?                   @relation("ExitClearanceApprover", fields: [approverId], references: [id], onDelete: SetNull)
  // Set instead of approverId when acted on via the public token link
  // (app/exit-clearance/[token]) rather than an authenticated session.
  approverName   String?                 @map("approver_name")
  status         ClearanceApprovalStatus @default(PENDING)
  comments       String?
  checklistItems Json?                   @map("checklist_items")
  actionDate     DateTime?               @map("action_date")
  // Public no-login approval link, generated per department when
  // initiateExitClearance() fans out the 5 rows. Nullable only because rows
  // created before this field existed have none.
  token          String?                 @unique

  @@unique([terminationId, department])
  @@map("exit_clearance_approvals")
}

// A Team Leader's public, no-login submission (app/resign) reporting a VA
// resignation — deliberately NOT a Termination yet, since Termination.vaProfileId
// is a required FK and the submitter only typed a free-text VA identifier.
// HR reviews it from the Offboarding tab, matches it to a real VAProfile, and
// converts it into a real resignation case (see convertResignationIntake()).
// The Ticket is created immediately on submission (visible to HR right away,
// same as the rest of the offboarding system) and reused — not duplicated —
// once converted.
model ResignationIntake {
  id              String                  @id @default(cuid())
  ticketId        String                  @unique @map("ticket_id")
  ticket          Ticket                  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  teamLeaderName  String                  @map("team_leader_name")
  teamLeaderEmail String                  @map("team_leader_email")
  vaIdentifier    String                  @map("va_identifier")
  departmentId    String?                 @map("department_id")
  department      Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  reason          String?
  status          ResignationIntakeStatus @default(PENDING_REVIEW)
  terminationId   String?                 @unique @map("termination_id")
  termination     Termination?            @relation(fields: [terminationId], references: [id], onDelete: SetNull)
  reviewedById    String?                 @map("reviewed_by_id")
  reviewedBy      User?                   @relation("ResignationIntakeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?               @map("reviewed_at")
  createdAt       DateTime                @default(now()) @map("created_at")

  @@index([status])
  @@map("resignation_intakes")
}

// The 5 fixed SOP policy-checklist items gating HR Manager endorsement
// (BR-10) — explicit columns since these are fixed legal/policy items,
// unlike the per-department checklist above.
model ComplianceReview {
  id            String      @id @default(cuid())
  terminationId String      @unique @map("termination_id")
  termination   Termination @relation(fields: [terminationId], references: [id], onDelete: Cascade)

  properlyConducted        Boolean @default(false) @map("properly_conducted")
  voluntaryConfirmation    Boolean @default(false) @map("voluntary_confirmation")
  noticePeriodCommunicated Boolean @default(false) @map("notice_period_communicated")
  noUnresolvedIssues       Boolean @default(false) @map("no_unresolved_issues")
  turnoverAcknowledged     Boolean @default(false) @map("turnover_acknowledged")

  overallResult ComplianceReviewResult? @map("overall_result")
  reviewedById  String?                 @map("reviewed_by_id")
  reviewedBy    User?                   @relation("ComplianceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?               @map("reviewed_at")

  @@map("compliance_reviews")
}

// Separate from the existing ExitClearance.finalPayCleared boolean, which
// stays as the simple non-SLA-tracked path for other termination types.
model FinalPayout {
  id            String      @id @default(cuid())
  terminationId String      @unique @map("termination_id")
  termination   Termination @relation(fields: [terminationId], references: [id], onDelete: Cascade)

  amount       Decimal?
  endorsedById String?           @map("endorsed_by_id")
  endorsedBy   User?             @relation("FinalPayoutEndorsedBy", fields: [endorsedById], references: [id], onDelete: SetNull)
  endorsedAt   DateTime?         @map("endorsed_at")
  slaDueDate   DateTime?         @map("sla_due_date")
  processedAt  DateTime?         @map("processed_at")
  status       FinalPayoutStatus @default(PENDING)

  @@map("final_payouts")
}

model ExitSurveyInvite {
  id            String      @id @default(cuid())
  terminationId String      @unique @map("termination_id")
  termination   Termination @relation(fields: [terminationId], references: [id], onDelete: Cascade)
  token         String      @unique
  expiresAt     DateTime    @map("expires_at")
  completedAt   DateTime?   @map("completed_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  response ExitSurveyResponse?

  @@map("exit_survey_invites")
}

model ExitSurveyResponse {
  id                 String           @id @default(cuid())
  inviteId           String           @unique @map("invite_id")
  invite             ExitSurveyInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  reasonForLeaving   String?          @map("reason_for_leaving")
  feedback           String?
  wouldRecommend     Boolean?         @map("would_recommend")
  additionalComments String?          @map("additional_comments")
  submittedAt        DateTime         @default(now()) @map("submitted_at")

  @@map("exit_survey_responses")
}

model ExitClearance {
  id                     String      @id @default(cuid())
  terminationId          String      @unique @map("termination_id")
  termination            Termination @relation(fields: [terminationId], references: [id], onDelete: Cascade)
  equipmentReturned      Boolean     @default(false) @map("equipment_returned")
  accountsRevoked        Boolean     @default(false) @map("accounts_revoked")
  documentsSubmitted     Boolean     @default(false) @map("documents_submitted")
  finalPayCleared        Boolean     @default(false) @map("final_pay_cleared")
  outstandingBalanceNote String?     @map("outstanding_balance_note")
  clearedById            String?     @map("cleared_by_id")
  clearedBy              User?       @relation("ClearanceClearedBy", fields: [clearedById], references: [id], onDelete: SetNull)
  clearedAt              DateTime?   @map("cleared_at")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  @@map("exit_clearances")
}

// ── Phase 5: Messaging ───────────────────────────────────────────

enum ChannelKind {
  DEPARTMENT
  DIRECT
  ANNOUNCEMENTS
}

model Channel {
  id           String      @id @default(cuid())
  kind         ChannelKind @default(DEPARTMENT)
  departmentId String?     @unique @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  dmKey        String?     @unique @map("dm_key")
  createdAt    DateTime    @default(now()) @map("created_at")

  messages     Message[]
  reads        ChannelRead[]
  participants ChannelParticipant[]

  @@map("channels")
}

model ChannelParticipant {
  id        String    @id @default(cuid())
  channelId String    @map("channel_id")
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  muted     Boolean   @default(false)
  archived  Boolean   @default(false)
  clearedAt DateTime? @map("cleared_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([channelId, userId])
  @@index([userId])
  @@map("channel_participants")
}

model Message {
  id        String           @id @default(cuid())
  channelId String           @map("channel_id")
  channel   Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId  String           @map("sender_id")
  sender    User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  mentions  MessageMention[]
  createdAt DateTime         @default(now()) @map("created_at")

  editedAt  DateTime? @map("edited_at")
  deletedAt DateTime? @map("deleted_at")

  parentId String?   @map("parent_id")
  parent   Message?  @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Message[] @relation("MessageReplies")

  pinned       Boolean   @default(false)
  pinnedAt     DateTime? @map("pinned_at")
  pinnedBy     String?   @map("pinned_by")
  pinnedByUser User?     @relation("MessagePinnedBy", fields: [pinnedBy], references: [id], onDelete: SetNull)

  forwardedFromId         String? @map("forwarded_from_id")
  forwardedFromBody       String? @map("forwarded_from_body")
  forwardedFromSenderName String? @map("forwarded_from_sender_name")

  @@index([channelId, createdAt])
  @@index([parentId])
  @@index([channelId, pinned])
  @@map("messages")
}

model MessageMention {
  id              String   @id @default(cuid())
  messageId       String   @map("message_id")
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentionedUserId String   @map("mentioned_user_id")
  mentionedUser   User     @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([mentionedUserId])
  @@map("message_mentions")
}

model ChannelRead {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId  String   @map("channel_id")
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now()) @map("last_read_at")

  @@unique([userId, channelId])
  @@map("channel_reads")
}

// ──────────────────────────────────────────────────────────────────
// MODELS — Audit Trail
// ──────────────────────────────────────────────────────────────────

model AuditLog {
  id           String      @id @default(cuid())
  actorId      String      @map("actor_id")
  actor        User        @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action       AuditAction
  entityType   String      @map("entity_type")
  entityId     String      @map("entity_id")
  oldValues    Json?       @map("old_values")
  newValues    Json?       @map("new_values")
  metadata     Json?
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ──────────────────────────────────────────────────────────────────
// MODELS — External Sync (VAConnections Google Sheet import)
// ──────────────────────────────────────────────────────────────────

enum SyncEntityType {
  VA_PROFILE
  CLIENT
}

// Maps the manager's Google Sheet IDs (VAID, ClientID) to this app's
// VAProfile/Client records. Assignment itself doesn't need a row here —
// it's matched directly via Assignment.externalId (the sheet's ConnectionID).
model ExternalSyncMapping {
  id         String         @id @default(cuid())
  source     String         @default("va_connections_sheet")
  entityType SyncEntityType @map("entity_type")
  externalId String         @map("external_id")
  internalId String         @map("internal_id")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@unique([source, entityType, externalId])
  @@index([internalId])
  @@map("external_sync_mappings")
}

// Raw mirror of the manager's VAConnections sheet — "load" phase only.
// Every row that has a ConnectionID gets stored here as-is on each sync run,
// regardless of whether it resolves to a real VAProfile/Client. Turning a row
// into an actual Assignment (the "connect" phase) is deliberately separate
// and not wired in yet.
model VAConnectionRecord {
  id               String   @id @default(cuid())
  connectionId     String   @unique @map("connection_id")
  status           String
  connectionType   String?  @map("connection_type")
  vaExternalId     String?  @map("va_external_id")
  vaName           String?  @map("va_name")
  clientExternalId String?  @map("client_external_id")
  clientName       String?  @map("client_name")
  department       String?
  service          String?
  hours            String?
  hoursType        String?  @map("hours_type")
  connectionDate   String?  @map("connection_date")
  startDate        String?  @map("start_date")
  terminationDate  String?  @map("termination_date")
  notes            String?
  raw              Json
  lastSyncedAt     DateTime @map("last_synced_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([vaName])
  @@index([clientName])
  @@map("va_connection_records")
}

// Mirror of the CMS's "Customers" tab — the real company/person identity.
// One Customer can own several Accounts (see Account below); a Customer
// itself is never directly staffed, only its Accounts are.
model Customer {
  id                  String    @id @default(cuid())
  externalCustomerId  String    @unique @map("external_customer_id")
  name                String
  status              String?
  statusDate          DateTime? @map("status_date")
  assignedSpecialist  String?   @map("assigned_specialist")
  createdByEmail      String?   @map("created_by_email")
  updatedByEmail      String?   @map("updated_by_email")
  notes               String?
  paymentDate         DateTime? @map("payment_date")
  noPaymentYet        Boolean?  @map("no_payment_yet")
  terminationCount    Int?      @map("termination_count")
  reactivationCount   Int?      @map("reactivation_count")
  lastTerminatedDate  DateTime? @map("last_terminated_date")
  lastReactivatedDate DateTime? @map("last_reactivated_date")
  lastStatusReason    String?   @map("last_status_reason")
  statusHistory       String?   @map("status_history")
  cmsCreatedAt        DateTime? @map("cms_created_at")
  cmsUpdatedAt        DateTime? @map("cms_updated_at")
  raw                 Json
  source              String    @default("cms_sheet")
  lastSyncedAt        DateTime  @map("last_synced_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  accounts Account[]

  @@index([name])
  @@index([status])
  @@map("customers")
}

// Mirror of the CMS's "Clients" tab — labeled "Accounts" in this app to
// avoid clashing with our own Client (Client Assignment) model. One Account
// belongs to one Customer; one Account can have many Client Assignments
// (one per department staffing request against that account).
model Account {
  id                 String    @id @default(cuid())
  externalAccountId  String    @unique @map("external_account_id")
  externalCustomerId String?   @map("external_customer_id")
  customerId         String?   @map("customer_id")
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName            String?   @map("customer_name")
  accountName             String?   @map("account_name")
  primaryContact          String?   @map("primary_contact")
  secondaryContact        String?   @map("secondary_contact")
  companyName             String?   @map("company_name")
  accountManagers         String?   @map("account_managers")
  invoiceContactName      String?   @map("invoice_contact_name")
  invoiceContactRole      String?   @map("invoice_contact_role")
  invoiceContactEmail     String?   @map("invoice_contact_email")
  category                String?
  type                    String?
  countryRegion           String?   @map("country_region")
  status                  String?
  statusDate              DateTime? @map("status_date")
  isReturning             Boolean?  @map("is_returning")
  notes                   String?
  primaryRole             String?   @map("primary_role")
  primaryEmail            String?   @map("primary_email")
  primaryIsFocal          Boolean?  @map("primary_is_focal")
  secondaryRole           String?   @map("secondary_role")
  secondaryEmail          String?   @map("secondary_email")
  secondaryIsFocal        Boolean?  @map("secondary_is_focal")
  primaryLinkedToCustomer Boolean?  @map("primary_linked_to_customer")
  terminationReason       String?   @map("termination_reason")
  sellerOnboardingLink    String?   @map("seller_onboarding_link")
  contractId              String?   @map("contract_id")
  createdByEmail          String?   @map("created_by_email")
  updatedByEmail          String?   @map("updated_by_email")
  cmsCreatedAt            DateTime? @map("cms_created_at")
  cmsUpdatedAt            DateTime? @map("cms_updated_at")
  raw                     Json
  source                  String    @default("cms_sheet")
  lastSyncedAt            DateTime  @map("last_synced_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  clientAssignments Client[]

  @@index([externalCustomerId])
  @@index([customerId])
  @@index([accountName])
  @@index([companyName])
  @@index([status])
  @@map("accounts")
}

model Notification {
  id                 String           @id @default(cuid())
  recipientId        String           @map("recipient_id")
  recipient          User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type               NotificationType
  title              String
  message            String
  entityType         String?          @map("entity_type")
  entityId           String?          @map("entity_id")
  messageId          String?          @map("message_id")
  mentionerName      String?          @map("mentioner_name")
  mentionerAvatarUrl String?          @map("mentioner_avatar_url")
  departmentName     String?          @map("department_name")
  read               Boolean          @default(false)
  createdAt          DateTime         @default(now()) @map("created_at")

  @@index([recipientId, read, createdAt])
  @@map("notifications")
}

